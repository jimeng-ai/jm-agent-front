# CI 用的「镜像组装」文件：只把宿主机上已经构建好的 dist 装进 nginx，不在容器里跑 vite。
#
# 为什么不用根目录那个多阶段 Dockerfile：这台机器就是 prod，Docker VM 只有 7.75G 而常驻容器
# （ds-data-server / ds-elasticsearch / ds-nacos …）已占掉大半，可用内存长期只剩 ~1.6G，
# 而 vite build 峰值需要 ≥1.5G。实测「构建能成功」和「不把 VM 内存打穿连累 prod」这两个
# 区间没有交集，详见 .github/workflows/deploy.yml 里 "Build front (on host)" 的注释。
#
# 用之前必须先在宿主机跑 `npm run build` 生成 dist —— .dockerignore 已为此放行 dist。
# 根目录的 Dockerfile 保留给「自洽构建」场景（内存充足的机器 / 别处部署），两者产出的镜像等价。
FROM nginx:1.27-alpine
# 与 Dockerfile 同义：nginx.deploy.conf 走宿主生产网关 host.docker.internal:20011；
# nginx.conf 走 compose 网络内的 data-service-gateway:8080。
ARG NGINX_CONF=nginx.deploy.conf
COPY dist /usr/share/nginx/html
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
